# Copy these to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.

# Supabase transaction pooler (port 6543) for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct connection (port 5432) for migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required on Vercel / custom domains so NextAuth trusts the forwarded host.
AUTH_TRUST_HOST="true"
